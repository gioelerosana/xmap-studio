{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xmap-studio",
  "compatibility_date": "2026-09-01",
  // L'app è una SPA tutta lato client: nessun codice Worker, solo asset statici
  // serviti dalla rete Cloudflare (nessun origin da far cadere). Intestazioni di
  // cache e sicurezza in apps/web/public/_headers.
  "assets": {
    "directory": "./apps/web/dist"
  },
  "routes": [{ "pattern": "xmap.jshep.xyz", "custom_domain": true }],
  "workers_dev": false,
  // Spenti in produzione (workers.dev), accesi solo per le anteprime delle PR:
  // URL del tipo <hash>-xmap-studio.<sottodominio>.workers.dev.
  "preview_urls": true,
  "observability": { "enabled": false },
  // Richiesto da `wrangler preview` (build dei branch/PR su Workers Builds):
  // vuoto, le anteprime ereditano asset e compatibilità dal livello superiore.
  "previews": {}
}
