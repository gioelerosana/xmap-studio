# Build Rust (copre anche src-tauri/target e xtask/target)
target/

# Artefatti di distribuzione
dist/
*.AppImage

# Renderer MathJax: rigenerato automaticamente da build.rs
# (copiato dall'oracolo ~/.local/share/xmind-latex oppure via `npm install`)
src-tauri/resources/renderer/node_modules/
src-tauri/resources/renderer/package.json
src-tauri/resources/renderer/package-lock.json

# Backup e file temporanei generati dall'app durante il salvataggio
.xmap-studio/
# Vecchio nome della cartella backup: resta ignorato per gli archivi esistenti
.xmind-equation-studio/
*.backup.*.xmind
.xmind-eq-*.tmp

# Log, editor, OS
*.log
*.swp
*.swo
.DS_Store

# Dipendenze Node e progetto web locale (non fanno parte dell'app desktop)
node_modules/
/apps/
/packages/
