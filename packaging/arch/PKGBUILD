# Pacchetto Arch Linux di sviluppo per XMap Studio (VCS: git).
# Costruito dall'ultimo commit di `main`, dal repository che contiene questo file.
#
#   cd packaging/arch && makepkg -si
#
# Niente clone né download del repository: a ogni build si aggiorna `main` del
# clone locale da origin (fetch + fast-forward, senza cambiare il branch in
# cui sei) e si esporta quel commit in src/ con `git archive`. Modifiche non
# committate e altri branch non entrano nel pacchetto. Usa l'Electron di
# sistema invece di quello di npm.
#
# Versione: r<numero di commit>.g<hash> del commit di `main` compilato
# (pacman -Q xmap-studio-git dice quale commit è installato). È svincolata
# dalle release e da xmap-studio-bin su AUR. Si calcola qui sotto quando
# makepkg legge il file, non con una funzione pkgver(): così makepkg non
# riscrive il PKGBUILD e il clone resta pulito per i git pull.

_pkgname=xmap-studio
pkgname=$_pkgname-git
url='https://github.com/gioelerosana/xmap-studio'

# makepkg rilegge il PKGBUILD più volte (anche dentro fakeroot): `main` si
# aggiorna e il commit si fissa alla prima lettura, poi passa alle successive
# via ambiente.
if [[ -z ${_XMAP_GIT_COMMIT:-} ]]; then
  _XMAP_GIT_REPO=$(git -C "$startdir" rev-parse --show-toplevel) || exit 1
  if git -C "$_XMAP_GIT_REPO" fetch --quiet origin main; then
    if [[ $(git -C "$_XMAP_GIT_REPO" branch --show-current) == main ]]; then
      # Sei su main: pull in fast-forward (si ferma se ci sono conflitti).
      git -C "$_XMAP_GIT_REPO" merge --ff-only --quiet FETCH_HEAD \
        || echo "==> ATTENZIONE: main non aggiornato (non in fast-forward o modifiche locali in conflitto)" >&2
    else
      # Altro branch: si sposta solo il ref di main, il working tree non cambia.
      git -C "$_XMAP_GIT_REPO" fetch --quiet origin main:main \
        || echo "==> ATTENZIONE: main locale non aggiornato (non in fast-forward con origin/main)" >&2
    fi
  else
    echo "==> ATTENZIONE: fetch di origin/main fallito, uso il main locale" >&2
  fi
  _XMAP_GIT_COMMIT=$(git -C "$_XMAP_GIT_REPO" rev-parse --verify --quiet 'refs/heads/main^{commit}') || {
    echo "==> ERRORE: branch main non trovato in $_XMAP_GIT_REPO" >&2
    exit 1
  }
  _XMAP_GIT_PKGVER="r$(git -C "$_XMAP_GIT_REPO" rev-list --count "$_XMAP_GIT_COMMIT").g${_XMAP_GIT_COMMIT:0:7}"
  export _XMAP_GIT_REPO _XMAP_GIT_COMMIT _XMAP_GIT_PKGVER
fi

pkgver=$_XMAP_GIT_PKGVER
pkgrel=1
pkgdesc='Free and open-source mind map editor for .xmind files, with native LaTeX formulas (development build)'
arch=('x86_64')
license=('MIT')
provides=("$_pkgname")
conflicts=("$_pkgname")
_electron=electron44
depends=("$_electron")
# pnpm serve nel PATH (anche installato fuori da pacman).
makedepends=('git' 'nodejs')
options=('!strip' '!debug')
source=('xmap-studio.sh'
        'org.joel.xmap_studio.desktop')
sha256sums=('SKIP' 'SKIP')

prepare() {
  # Copia esatta del commit di main, senza la cartella .git.
  rm -rf "$srcdir/$_pkgname"
  mkdir -p "$srcdir/$_pkgname"
  git -C "$_XMAP_GIT_REPO" archive --format=tar "$_XMAP_GIT_COMMIT" \
    | bsdtar -xf - -C "$srcdir/$_pkgname"
}

build() {
  cd "$_pkgname"
  # Electron arriva dal pacchetto di sistema: niente download del binario npm.
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1
  pnpm install --frozen-lockfile --prefer-offline
  pnpm build
  rm -rf "$srcdir/deploy"
  pnpm --filter @xmap/desktop deploy --prod --legacy "$srcdir/deploy"
}

package() {
  cd "$_pkgname"
  local app="$pkgdir/usr/lib/$_pkgname"

  # main.js cerca la UI in ../../web/dist rispetto a apps/desktop/dist.
  install -d "$app/apps/desktop" "$app/apps/web"
  cp -a "$srcdir/deploy/." "$app/apps/desktop/"
  # .modules.yaml di pnpm contiene percorsi di $srcdir: non serve a runtime
  rm -f "$app/apps/desktop/node_modules/.modules.yaml"
  cp -a apps/web/dist "$app/apps/web/dist"

  sed "s/@ELECTRON@/$_electron/" "$srcdir/xmap-studio.sh" > xmap-studio.launcher
  install -Dm755 xmap-studio.launcher "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 "$srcdir/org.joel.xmap_studio.desktop" \
    "$pkgdir/usr/share/applications/org.joel.xmap_studio.desktop"
  install -Dm644 assets/org.joel.xmap_studio.xml \
    "$pkgdir/usr/share/mime/packages/org.joel.xmap_studio.xml"
  install -Dm644 assets/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.joel.xmap_studio.svg"
  install -Dm644 assets/icon-256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/org.joel.xmap_studio.png"
  install -Dm644 assets/icon-512.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/org.joel.xmap_studio.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
